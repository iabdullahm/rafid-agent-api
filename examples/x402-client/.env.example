# --- Rafid Agent API x402 client example -----------------------------------------------
# Copy this file to .env and fill in the values you need. Never commit .env — it is already
# listed in .gitignore.

# The base URL of the deployed Rafid Agent API. Defaults to production if left unset.
RAFID_API_URL=https://rafid-agent-api.vercel.app

# --- Only required for `npm run test:x402-payment` --------------------------------------
# NOT needed for `npm run test:x402-unpaid`, which never touches a wallet.

# The private key of YOUR OWN wallet that will PAY for x402 calls. This wallet needs a small
# amount of real USDC (and a small amount of ETH for gas, if the scheme requires it) on Base
# Mainnet. 0x-prefixed, 64 hex characters.
#
#   - NEVER commit this file with a real value in it.
#   - NEVER paste this key anywhere else, or share it with anyone, including in a support
#     request. Whoever holds this key can spend everything in that wallet.
#   - This must be a wallet you control and are comfortable spending small real amounts
#     from — it is not the Rafid Agent API's receiving wallet, and this example never
#     changes or needs to know that receiving wallet (the server tells the client where to
#     pay, per request, via the x402 protocol itself).
#   - Consider using a wallet funded with only a few dollars of USDC, dedicated to testing,
#     rather than a wallet holding significant funds.
X402_PAYER_PRIVATE_KEY=

# Every real payment run asks for an explicit typed confirmation before it sends a
# transaction, because this moves real money on Base Mainnet. Set this to "true" only if you
# want to skip that interactive prompt (for example, a scripted/CI run you've already
# reviewed) — leave it unset or "false" to always be asked.
X402_CONFIRM_MAINNET=false
