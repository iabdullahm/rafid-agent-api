# Rafid deployment to call (MPP must be enabled there: GET <base>/api/v1/mpp/status).
RAFID_BASE_URL=https://api.rafidsystem.com

# Payer wallet for MPP payments. NEVER commit a real key; use a dedicated, low-balance wallet.
# Tempo: needs USDC (mainnet) or pathUSD (testnet) plus a little fee token.
MPP_CLIENT_PRIVATE_KEY=

# Session examples: the most this client will ever lock in a payment channel (USD).
MPP_CLIENT_MAX_DEPOSIT=10

# e2e:session only (Tempo TESTNET; the script refuses any non-testnet target).
# Optional custom Tempo testnet RPC (defaults to viem's tempoModerato RPC).
TEMPO_TESTNET_RPC_URL=
# Session budget for the e2e run (USD; small on purpose).
E2E_BUDGET_USD=0.05
