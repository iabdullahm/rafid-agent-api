PORT=8787
NODE_ENV=development
AUTH_MODE=env
# Set AUTH_MODE=postgres after creating a database and running npm run admin -- migrate.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR-PROJECT-pooler.REGION.aws.neon.tech/neondb?channel_binding=require&sslmode=require
# Generate a random key; blank deliberately prevents HTTP startup.
# Multiple keys: comma-separated, each at least 24 characters.
RAFID_API_KEYS=
LOG_LEVEL=info
X402_ENABLED=false
# Set true to accept pay-per-call crypto payments at /api/v1/x402/... (no API key needed there).
# X402_WALLET_ADDRESS is required when enabled; must be a 0x-prefixed EVM address you control.
X402_NETWORK=eip155:84532
X402_WALLET_ADDRESS=
X402_FACILITATOR_URL=https://x402.org/facilitator
# Required only when X402_NETWORK is not the public facilitator's Base Sepolia (eip155:84532) —
# e.g. Base mainnet (eip155:8453). Get these from a Coinbase Developer Platform account
# (Secret API Key, Ed25519). Set both together, or neither; never commit real values.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# L402 (Lightning) pay-per-call — a second payment rail next to x402, under /api/v1/l402/<tool>.
# Off by default; startup fails closed if enabled with anything below missing or invalid.
L402_ENABLED=false
# mainnet | testnet | signet | regtest — used for labeling (ledger network "lightning:<value>").
L402_NETWORK=mainnet
# Lightning backend that creates invoices: "lnd" (your own/hosted LND node) or "voltage"
# (a Voltage Payments wallet — hosted, no node to run).
L402_BACKEND=lnd
# --- L402_BACKEND=voltage: from your Voltage Payments dashboard (environment → API keys / wallet).
# Use a staging (Mutinynet) environment with L402_NETWORK=signet for testing, a production
# environment with L402_NETWORK=mainnet for real payments. Never commit the API key.
VOLTAGE_API_URL=https://voltageapi.com/v1
VOLTAGE_API_KEY=
VOLTAGE_ORGANIZATION_ID=
VOLTAGE_ENVIRONMENT_ID=
VOLTAGE_WALLET_ID=
# --- L402_BACKEND=lnd:
# Your LND node's REST endpoint (https only), e.g. a Voltage node: https://<name>.m.voltageapp.io:8080
LND_REST_URL=
# Hex of LND's invoice.macaroon (can create invoices only — cannot spend funds). Never commit it.
LND_INVOICE_MACAROON=
# Only for a self-signed node certificate: the tls.cert PEM, raw or base64. Leave blank for Voltage.
LND_TLS_CERT=
# Signs L402 macaroons. 32+ random bytes, hex: openssl rand -hex 32. Rotating it voids unused tokens.
L402_ROOT_KEY=
# Invoice lifetime; tokens stay valid for this plus one hour.
L402_INVOICE_EXPIRY_SECONDS=600
# BTC/USD rate cache (Coinbase spot, Kraken fallback); USD prices are converted to sats per challenge.
L402_RATE_CACHE_MS=60000

# MPP (Machine Payments Protocol, https://mpp.dev) — a third payment rail next to x402 and L402,
# under /api/v1/mpp/* (charge: one-time payment per call; session: budgeted, metered calls over a
# Tempo payment channel). Implemented with the official `mppx` SDK. Off by default; startup fails
# closed if enabled with anything below missing or invalid. See README "MPP".
MPP_ENABLED=false
MPP_PROVIDER=mppx
# tempo (mainnet, chain 4217, USDC) | tempo-testnet (Moderato, chain 42431, pathUSD)
MPP_NETWORK=tempo
# charge,session (either or both)
MPP_MODES=charge,session
# charge methods: tempo (Tempo USDC) and/or evm (Base USDC via the x402/CDP facilitator above)
MPP_CHARGE_METHODS=tempo
MPP_CURRENCY=USD
# HMAC key binding every challenge to its contents: >= 32 random bytes (openssl rand -base64 32).
MPP_SECRET_KEY=
# Stable realm bound into challenges (keep it identical across deployments).
MPP_REALM=api.rafidsystem.com
# Tempo payee key — REQUIRED for session mode (the payee submits TIP-1034 close/settle
# transactions). Use a dedicated wallet; never commit it. The payee address is derived from it
# unless MPP_TEMPO_RECIPIENT is set (charge-only deployments can set just the recipient).
MPP_TEMPO_PRIVATE_KEY=
MPP_TEMPO_RECIPIENT=
# Optional overrides (defaults: the chain's canonical USDC/pathUSD and public RPC).
MPP_TEMPO_CURRENCY=
MPP_TEMPO_RPC_URL=
# evm/charge: network (eip155:8453 needs CDP_API_KEY_ID/SECRET, like x402) and payee (defaults to X402_WALLET_ADDRESS).
MPP_EVM_NETWORK=eip155:8453
MPP_EVM_RECIPIENT=
MPP_SESSION_TTL_SECONDS=3600
MPP_MAX_SESSION_BUDGET_USD=1000
MPP_MIN_SESSION_BUDGET_USD=0.01
MPP_REQUIRE_IDEMPOTENCY=true
MPP_CHALLENGE_TTL_SECONDS=300
# Optional MPP-over-MCP payment layer at /mcp/mpp (the free /mcp endpoint is unaffected).
MPP_MCP_ENABLED=false
# Optional separate database for mpp_* tables (defaults to DATABASE_URL; required in production).
MPP_DATABASE_URL=
# Optional: USD per 1 BTC to use only if both public rate sources are down (blank = return 503 instead).
L402_BTC_USD_FALLBACK=
# Optional: separate database for single-use token enforcement (defaults to DATABASE_URL, which
# production requires when L402 is enabled).
L402_DATABASE_URL=

# Remote MCP (Streamable HTTP transport at /mcp), alongside local stdio. Set to false to unmount
# the route entirely (it then simply 404s), e.g. to roll back without a code change.
MCP_REMOTE_ENABLED=true

# Discovery metadata for /.well-known/ai-plugin.json. Left blank by default rather than
# fabricated; fill these in before submitting to a plugin store that enforces them.
RAFID_LOGO_URL=
RAFID_CONTACT_EMAIL=
RAFID_LEGAL_INFO_URL=

# Durable usage ledger: "console" (default, one JSON line to stderr per call), "memory" (local
# inspection only, lost on restart), or "postgres" (a queryable rafid_agent_usage table — reuses
# DATABASE_URL above; independent of AUTH_MODE).
USAGE_REPOSITORY=console

# Rate limiting for public, unauthenticated agent endpoints (discovery, x402, remote MCP). Set
# to false only for local development/tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Oman Business Intelligence Admin & Data Operations Dashboard (internal-only, never exposed to
# MCP/discovery/OpenAPI/x402 — see docs/business-admin.md). Leave all three blank to disable the
# dashboard entirely (its routes then don't exist at all, 404, rather than existing unprotected).
# Set all three together to enable it. ADMIN_PASSWORD_HASH is generated with
# `npm run admin:hash-password -- "your password"` (scrypt) — never a plaintext password.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MINUTES=60
ADMIN_LOGIN_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Also required to enable the dashboard's data: a real business database, either
# OMAN_BUSINESS_DATABASE_URL or DATABASE_URL (see docs/business-intelligence.md).
OMAN_BUSINESS_DATABASE_URL=

# Internal analytics layer (discovery hits, MCP protocol calls, x402 payment funnel, tool usage —
# GET /api/v1/internal/analytics/{summary,discovery,tools,x402}). Never a public dashboard: every
# route 503s until ANALYTICS_INTERNAL_API_KEY is set, then requires it via X-Internal-Api-Key.
# Recording itself always happens (to an in-process store when no database is configured), so
# only the read routes' availability depends on this key. Generate a random value; never commit
# a real one.
ANALYTICS_INTERNAL_API_KEY=
# Optional: a separate database for analytics events. Falls back to DATABASE_URL when unset (most
# deployments use one database for everything); without either, events are still recorded but
# lost on restart/redeploy (an in-process store, exactly like USAGE_REPOSITORY=memory above).
ANALYTICS_DATABASE_URL=

# Internal revenue / x402 settlement ledger (rafid_x402_settlements — the accounting source of
# truth, separate from the analytics layer above: only rows with status=settlement_succeeded ever
# count as revenue). GET /api/v1/internal/revenue/{summary,tools,transactions,reconciliation}.
# Never a public dashboard: every route 503s until REVENUE_INTERNAL_API_KEY is set, then requires
# it via X-Internal-Api-Key. A dedicated key, deliberately not shared with
# ANALYTICS_INTERNAL_API_KEY, so leaking one never exposes the other. Generate a random value;
# never commit a real one.
REVENUE_INTERNAL_API_KEY=
# Optional: a separate database for the settlement ledger. Falls back to DATABASE_URL when unset;
# without either, settlements are still recorded but lost on restart/redeploy (an in-process
# store). For real accounting data this should point at a durable, backed-up database.
REVENUE_DATABASE_URL=

# Optional on-chain settlement verification (src/revenue/chainVerifier.ts) — a SEPARATE,
# independent check of a settled x402 payment against the chain itself. The revenue ledger above
# never depends on this: settlements are recorded purely from facilitator-confirmed settlement
# data whether or not this is configured. Leave unset and verification simply reports
# "not_configured" rather than pretending to have checked anything. No blockchain-explorer API
# key is ever hardcoded — everything here is configuration.
# A JSON-RPC endpoint for the same network X402_NETWORK settles on (e.g. an Alchemy/Infura/
# self-hosted Base RPC URL). Never commit a real one with an embedded API key.
CHAIN_RPC_URL=
# The USDC ERC-20 contract address for a given network, keyed by that network's CAIP-2 id with
# non-alphanumeric characters uppercased/replaced with "_" (see chainVerifier.ts's
# usdcContractEnvVarName()). Example for Base mainnet (eip155:8453):
# CHAIN_USDC_CONTRACT_EIP155_8453=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Rafid Agent Intelligence (research_company, find_companies, analyze_company_risk —
# src/intelligence/config.ts). EVERY one of these defaults to off/not-configured: with nothing
# set below, all three capabilities still work and return a fully valid, schema-conformant,
# honest "not configured" result (no external network call, no cost). Set these only when you
# want the capabilities to actually consult a live provider.
# Web search provider (backs research_company/find_companies and the adverse_news/reputation/
# legal_signals checks of analyze_company_risk). "none" (default) or "tavily".
WEB_SEARCH_PROVIDER=none
# Required only when WEB_SEARCH_PROVIDER=tavily. Get a key at https://tavily.com. Never commit a
# real one.
TAVILY_API_KEY=
# LLM synthesis provider (turns raw web-search evidence into structured research_company/
# find_companies fields; analyze_company_risk never uses this). "none" (default) or "anthropic".
INTELLIGENCE_LLM_PROVIDER=none
# Required only when INTELLIGENCE_LLM_PROVIDER=anthropic. Never commit a real one.
ANTHROPIC_API_KEY=
# Required only when INTELLIGENCE_LLM_PROVIDER=anthropic — no default model is guessed; name the
# exact model you want, e.g. claude-sonnet-4-5.
INTELLIGENCE_LLM_MODEL=
# Enables analyze_company_risk's free-but-live checks (domain registration age via public RDAP,
# SSRF-safe website reachability, the public OFAC/Consolidated Screening List sanctions check).
# No API key required for these, but they DO make real outbound network calls, so they default to
# false. Set to "true" to enable.
RISK_LIVE_CHECKS_ENABLED=false
# Optional cache TTLs in milliseconds for research_company/find_companies (default 6 hours) and
# analyze_company_risk (default 30 minutes) results from a live provider. Never applied to the
# honest "not configured" result (see src/intelligence/cache.ts's doc comment).
INTELLIGENCE_CACHE_TTL_MS=
RISK_CACHE_TTL_MS=

# --- oman_supplier_check (procurement supplier screening) ---
# Website inspection and sanctions lists follow RISK_LIVE_CHECKS_ENABLED; public-web signals follow
# WEB_SEARCH_PROVIDER. Optional overrides below — leave blank for defaults.
# Sanctions providers: comma list of "un" (UN Security Council Consolidated List) and "csl"
# (US Consolidated Screening List, incl. OFAC SDN), or "none". Default: both when
# RISK_LIVE_CHECKS_ENABLED=true, none otherwise.
SUPPLIER_SANCTIONS_PROVIDERS=
SUPPLIER_UN_SANCTIONS_URL=
# trade.gov Consolidated Screening List endpoint + optional free subscription key (sent as the
# `subscription-key` header). Never commit a real key.
SANCTIONS_CSL_API_URL=
SANCTIONS_CSL_API_KEY=
# Evidence cache: PostgreSQL (table rafid_supplier_evidence) when a URL is available, falling back
# to DATABASE_URL; set SUPPLIER_EVIDENCE_STORE=memory to force the in-process cache.
SUPPLIER_EVIDENCE_DATABASE_URL=
SUPPLIER_EVIDENCE_STORE=
# Evidence TTLs in ms (defaults: identity 7d, website 3d, sanctions 12h, public web 1d).
SUPPLIER_IDENTITY_CACHE_TTL_MS=
SUPPLIER_WEBSITE_CACHE_TTL_MS=
SUPPLIER_SANCTIONS_CACHE_TTL_MS=
SUPPLIER_PUBLIC_RISK_CACHE_TTL_MS=

# --- company_reputation_check (global company reputation / risk intelligence, $0.40/call) ---
# Free public sources (GLEIF LEI index, RDAP, company website, UN list, US CSL) follow
# RISK_LIVE_CHECKS_ENABLED; news and review searches follow WEB_SEARCH_PROVIDER / TAVILY_API_KEY.
# Optional sources — leave blank to keep them disabled. Never commit real keys.
# UK Companies House public data API key (free, https://developer.company-information.service.gov.uk/).
COMPANIES_HOUSE_API_KEY=
# EU Financial Sanctions Files full XML URL, including the personal token the EU issues.
EU_SANCTIONS_LIST_URL=
# OpenSanctions matching API (commercial use requires a paid licence). URL override is optional.
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_API_URL=
# Comma-separated provider ids or categories to switch off (e.g. "reviews" or "news_web_search").
COMPANY_REPUTATION_DISABLED_PROVIDERS=
# Evidence cache: PostgreSQL table rafid_company_evidence_cache (falls back to DATABASE_URL);
# COMPANY_REPUTATION_EVIDENCE_STORE=memory forces the in-process cache.
COMPANY_REPUTATION_DATABASE_URL=
COMPANY_REPUTATION_EVIDENCE_STORE=
# Evidence TTLs in ms (defaults: registry 7d, sanctions 12h, news 1d, reviews 3d, website 3d, domain 7d)
COMPANY_REPUTATION_REGISTRY_TTL_MS=
COMPANY_REPUTATION_SANCTIONS_TTL_MS=
COMPANY_REPUTATION_NEWS_TTL_MS=
COMPANY_REPUTATION_REVIEWS_TTL_MS=
COMPANY_REPUTATION_WEBSITE_TTL_MS=
COMPANY_REPUTATION_DOMAIN_TTL_MS=
# How long expired evidence may still be served (flagged DATA_STALE) when a live source fails (default 14 days).
COMPANY_REPUTATION_MAX_STALE_MS=
# Per-provider time budget in ms (default 12000).
COMPANY_REPUTATION_PROVIDER_TIMEOUT_MS=
